<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- The log lives next to the metadata (sectoriadb.meta-dir), i.e. on the volume in Docker -->
    <springProperty scope="context" name="LOG_DIR" source="sectoriadb.meta-dir" defaultValue="./sectoriadb-meta"/>

    <!-- Console: concise format for shell readability -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level [%logger{20}] [%X{requestId:--} %X{operation:--}] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Rolling file: full format, daily roll, 30 days retention, 500 MB cap -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/sectoriadb.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/sectoriadb.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%X{requestId:--} %X{operation:--}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Application logger: INFO to both -->
    <logger name="org.example.sectoriadb" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Root: WARN to file only (suppress Spring noise from console) -->
    <root level="WARN">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
