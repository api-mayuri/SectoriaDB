# Copy to .env (git-ignored) and change the secrets. Used by docker-compose.yml and by ../warp/*.sh.
COMPOSE_PROFILES=server

# SectoriaDB under test (profile "server"): two accounts (main + alt, needed by ceph/s3-tests)
SECTORIADB_ACCESS_KEY=BENCHACCESSKEY0001
SECTORIADB_SECRET_KEY=benchsecretkey0123456789abcdef
SECTORIADB_ALT_ACCESS_KEY=ALTACCESSKEY00002
SECTORIADB_ALT_SECRET_KEY=altsecretkey0123456789abcdef
SECTORIADB_JAVA_OPTS=-Xmx1g -XX:+UseG1GC
# Extra -D / env overrides are recorded in bench/results/*/meta.json (see warp/run.sh)
SECTORIADB_FSYNC=true

# InfluxDB 2 (warp live results)
INFLUX_ORG=sectoria
INFLUX_BUCKET=warp
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-influx-password
INFLUX_TOKEN=change-me-influx-token-0123456789

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
INFLUX_PORT=8086
