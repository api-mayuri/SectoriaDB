# SectoriaDB Docker configuration
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# ── Network ───────────────────────────────────────────────────────────────────

# Port exposed on the host machine
HOST_PORT=8080

# Port the server listens on inside the container (rarely needs changing)
SERVER_PORT=8080

# Порт метрик Prometheus и health (/actuator/prometheus), публикуется только на 127.0.0.1 хоста
METRICS_HOST_PORT=9464
MANAGEMENT_SERVER_PORT=9464

# ── S3 API ────────────────────────────────────────────────────────────────────

# Region name returned in S3 responses (cosmetic, used in SigV4 credential scope)
SECTORIADB_S3_REGION=us-east-1

# Enable AWS Signature Version 4 authentication
# Set to false to allow unauthenticated access (useful for local dev/testing)
# When true and no credentials exist in /data/meta/credentials.json, all requests are DENIED
# until you create a key (shell command `mk-key`) or set the variables below.
SECTORIADB_S3_AUTH_ENABLED=true

# Explicit opt-in to the old "bootstrap mode": with auth enabled and no keys, let every request through.
# SECTORIADB_S3_AUTH_ALLOW_OPEN_SETUP=false

# Accept UNSIGNED-PAYLOAD on signed requests (the AWS default for HTTPS clients). Set to false to
# force a signed payload hash / signed chunks, i.e. every upload body is integrity-checked.
# SECTORIADB_S3_AUTH_ALLOW_UNSIGNED_PAYLOAD=true

# Multiple S3 credentials (comma-separated, format: ACCESS:SECRET or ACCESS:SECRET:description)
# Example: SECTORIADB_S3_CREDENTIALS=AKIAIOSFODNN7EXAMPLE:wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY,AKIAIOSFODNN7ANOTHER:yWalrXUtnFEMI/K7MDENG/cPxRfiCYEXAMPLEKEY:prod-key
# If not set, old SECTORIADB_S3_ACCESS_KEY and SECTORIADB_S3_SECRET_KEY are used (backward compatibility)
# SECTORIADB_S3_CREDENTIALS=

# Legacy: single access key / secret key pair (used if SECTORIADB_S3_CREDENTIALS is not set)
# SECTORIADB_S3_ACCESS_KEY=
# SECTORIADB_S3_SECRET_KEY=

# ── JVM ───────────────────────────────────────────────────────────────────────

# JVM flags passed to the process
# Increase -Xmx for large file workloads
JAVA_OPTS=-Xmx512m -XX:+UseG1GC

# ── Usage ─────────────────────────────────────────────────────────────────────
#
# Start:
#   docker compose up -d
#
# Create access keys (first run, auth is open while credentials.json is empty):
#   docker compose exec sectoriadb java -jar sectoriadb.jar mk-key --count 3 --desc "dev keys"
#
# OR create a single key:
#   docker compose exec sectoriadb java -jar sectoriadb.jar mk-key --desc "my key"
#
# Create key with custom values (only --count 1):
#   docker compose exec sectoriadb java -jar sectoriadb.jar mk-key --count 1 --access-key AKIAIOSFODNN7EXAMPLE --secret-key wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#
# List all keys:
#   docker compose exec sectoriadb java -jar sectoriadb.jar keys
#
# List with secret keys shown:
#   docker compose exec sectoriadb java -jar sectoriadb.jar keys --secret
#
# Disable/enable a key:
#   docker compose exec sectoriadb java -jar sectoriadb.jar disable-key --id SCTRIAXXXXXXXXXXX
#   docker compose exec sectoriadb java -jar sectoriadb.jar enable-key --id SCTRIAXXXXXXXXXXX
#
# Delete one or more keys:
#   docker compose exec sectoriadb java -jar sectoriadb.jar rm-key --id KEY1,KEY2,KEY3 --yes
#
# OR set multiple credentials via environment (in .env file):
#   SECTORIADB_S3_CREDENTIALS=ak1:sk1:key1-description,ak2:sk2:key2-description
#   docker compose up -d
#
# Configure AWS CLI:
#   aws configure set aws_access_key_id     <AccessKeyId>
#   aws configure set aws_secret_access_key <SecretKey>
#   aws configure set default.region        us-east-1
#
# Test:
#   aws s3 --endpoint-url http://localhost:8080 ls
#   aws s3 --endpoint-url http://localhost:8080 mb s3://my-bucket
#   aws s3 --endpoint-url http://localhost:8080 cp file.txt s3://my-bucket/
